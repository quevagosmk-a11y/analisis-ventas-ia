# Copia este archivo como ".env.vps" en el VPS antes de levantar el stack.

# Puerto publico de la aplicacion.
APP_PUBLIC_PORT=80

# Base de datos MySQL
DB_NAME=la_septima_estrella
DB_PASSWORD=cambia-esta-clave-mysql

# Aplicacion
APP_SECRET_KEY=define-una-clave-larga-y-unica
PASSWORD_HASH_ITERATIONS=390000
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
APP_AUTO_BACKUP=1
APP_AUTO_BACKUP_INTERVAL=120

# Usuarios semilla para primer arranque
DEFAULT_ADMIN_PASSWORD=Admin2026@
DEFAULT_VENDOR_PASSWORD=Vendedor2026@

# IA externa opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=500
AI_ENGINE=auto
OLLAMA_API_BASE=
OLLAMA_API_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=45
