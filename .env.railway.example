# Variables sugeridas para desplegar la app web en Railway.
# La base MySQL se agrega como un servicio aparte dentro del mismo proyecto Railway.

# Referencia desde el servicio web al servicio MySQL de Railway.
# En la UI de Railway crea esta variable como "Reference" hacia MYSQL_URL del servicio MySQL.
DATABASE_URL=

# Seguridad y sesiones
APP_SECRET_KEY=define-una-clave-larga-y-unica
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=1
PASSWORD_HASH_ITERATIONS=390000
FLASK_DEBUG=0
ALLOW_DEV_LOGIN=0

# Usuarios base (bootstrap inicial)
DEFAULT_ADMIN_PASSWORD=Admin2026@
DEFAULT_VENDOR_PASSWORD=Vendedor2026@

# Respaldos
# Si agregas un volumen a la app en Railway, el backend usara automaticamente
# RAILWAY_VOLUME_MOUNT_PATH/backups. No hace falta definir APP_BACKUP_DIR.
APP_AUTO_BACKUP=1
APP_AUTO_BACKUP_INTERVAL=120
APP_BACKUP_KEEP=15

# IA opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=500
AI_ENGINE=auto
OLLAMA_API_BASE=
OLLAMA_API_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=45
