# Copia este archivo como ".env.docker" antes de ejecutar Docker

# MySQL
DB_NAME=la_septima_estrella
DB_PASSWORD=changeme

# App
APP_SECRET_KEY=define-una-clave-larga-y-unica
FLASK_DEBUG=0
PASSWORD_HASH_ITERATIONS=390000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=500
# Configuración IA: auto (openai primero si hay llave, luego ollama), openai, ollama
AI_ENGINE=auto
# Deja vacío para no usar Ollama (usa respuestas locales del sistema).
OLLAMA_API_BASE=
OLLAMA_API_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=45

# Usuarios semilla (solo en bootstrap inicial)
DEFAULT_ADMIN_PASSWORD=Admin2026@
DEFAULT_VENDOR_PASSWORD=Vendedor2026@
