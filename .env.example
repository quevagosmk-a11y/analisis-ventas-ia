# Datos de conexión a MySQL
# Local sin Docker: DB_HOST=127.0.0.1
# Con Docker Compose: DB_HOST=mysql
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=la_septima_estrella

# Configuración de sesiones
SESSION_IDLE_TIMEOUT_MINUTES=45
SESSION_MAX_AGE_DAYS=5
APP_SECRET_KEY=define-una-clave-larga-y-unica
FLASK_DEBUG=0
PASSWORD_HASH_ITERATIONS=390000

# Cookies
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0

# Parámetros adicionales
PRICE_CHANGE_MAX_RATIO=0.4
PRICE_FORCE_REASON_MIN_LENGTH=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=500
# Configuración IA: auto (openai primero si hay llave, luego ollama), openai, ollama
AI_ENGINE=auto
# Deja vacío para no usar Ollama (usa respuestas locales del sistema).
OLLAMA_API_BASE=
OLLAMA_API_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=45

# Usuarios semilla (bootstrap)
# Cambia estas contraseñas antes de entregar a producción.
DEFAULT_ADMIN_PASSWORD=Admin2026@
DEFAULT_VENDOR_PASSWORD=Vendedor2026@
ALLOW_DEV_LOGIN=0
